generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id                String              @id
  name              String
  ownerId           String
  icon              String?
  joinedAt          DateTime            @default(now())
  premium           Boolean             @default(false)
  premiumTier       String              @default("free")
  language          String              @default("en")
  embedColor        String              @default("#5865F2")
  footerText        String              @default("Powered by Wersee")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  autoModConfig     AutoModConfig?
  autoRoles         AutoRole[]
  customCommands    CustomCommand[]
  giveaways         Giveaway[]
  modules           GuildModule[]
  settings          GuildSetting[]
  logConfig         LogConfig?
  modCases          ModCase[]
  policePersonnel   PolicePersonnel[]
  policeRankHistory PoliceRankHistory[]
  notifications     Notification[]
  reactionRoles     ReactionRole[]
  tickets           Ticket[]
  levels            UserLevel[]
  verifyConfig      VerifyConfig?
  warnings          Warning[]
  welcomeConfig     WelcomeConfig?
}

model GuildModule {
  id        String   @id @default(cuid())
  guildId   String
  module    String
  enabled   Boolean  @default(false)
  config    String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, module])
}

model GuildSetting {
  id      String @id @default(cuid())
  guildId String
  key     String
  value   String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, key])
}

model User {
  id              String          @id
  username        String
  globalName      String?
  avatar          String?
  bio             String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  giveawayEntries GiveawayEntry[]
  modActions      ModCase[]       @relation("ModCaseModerator")
  modCases        ModCase[]       @relation("ModCaseUser")
  claimedTickets  Ticket[]        @relation("TicketClaimer")
  tickets         Ticket[]        @relation("TicketCreator")
  levels          UserLevel[]
  warnings        Warning[]
}

model ModCase {
  id          String    @id @default(cuid())
  caseNumber  Int
  guildId     String
  userId      String
  moderatorId String
  action      String
  reason      String
  duration    String?
  evidence    String    @default("[]")
  notes       String?
  photoUrl    String?
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  moderator   User      @relation("ModCaseModerator", fields: [moderatorId], references: [id])
  user        User      @relation("ModCaseUser", fields: [userId], references: [id])

  @@unique([guildId, caseNumber])
  @@index([guildId, userId])
}

model Warning {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  moderatorId String
  reason      String
  points      Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([guildId, userId])
}

model Ticket {
  id           String          @id @default(cuid())
  ticketNumber Int
  guildId      String
  channelId    String          @unique
  userId       String
  claimedById  String?
  category     String          @default("support")
  priority     String          @default("medium")
  status       String          @default("open")
  subject      String?
  tags         String          @default("[]")
  rating       Int?
  transcript   String?
  closedAt     DateTime?
  closedById   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  claimedBy    User?           @relation("TicketClaimer", fields: [claimedById], references: [id])
  guild        Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user         User            @relation("TicketCreator", fields: [userId], references: [id])
  messages     TicketMessage[]

  @@unique([guildId, ticketNumber])
  @@index([guildId, userId])
  @@index([guildId, status])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  content   String
  isStaff   Boolean  @default(false)
  isNote    Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model AutoRole {
  id      String @id @default(cuid())
  guildId String
  roleId  String
  type    String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model ReactionRole {
  id        String @id @default(cuid())
  guildId   String
  messageId String
  channelId String
  emoji     String
  roleId    String
  type      String @default("toggle")
  guild     Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([messageId, emoji])
  @@index([guildId])
}

model WelcomeConfig {
  id               String   @id @default(cuid())
  guildId          String   @unique
  enabled          Boolean  @default(true)
  channelId        String?
  message          String   @default("Welcome to {server}, {user}!")
  embedEnabled     Boolean  @default(true)
  embedTitle       String   @default("Welcome!")
  embedDescription String   @default("Welcome to **{server}**, {user}!\n\nYou are member **#{membercount}**.")
  embedColor       String   @default("#5865F2")
  embedThumbnail   Boolean  @default(true)
  embedImage       String?
  dmEnabled        Boolean  @default(false)
  dmMessage        String   @default("Welcome to **{server}**! Please read the rules.")
  goodbyeEnabled   Boolean  @default(false)
  goodbyeChannelId String?
  goodbyeMessage   String   @default("{user} has left the server.")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model LogConfig {
  id                   String   @id @default(cuid())
  guildId              String   @unique
  enabled              Boolean  @default(true)
  messageLogChannel    String?
  memberLogChannel     String?
  moderationLogChannel String?
  serverLogChannel     String?
  voiceLogChannel      String?
  allLogChannel        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  guild                Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model VerifyConfig {
  id               String   @id @default(cuid())
  guildId          String   @unique
  enabled          Boolean  @default(true)
  type             String   @default("button")
  channelId        String?
  verifiedRoleId   String?
  unverifiedRoleId String?
  minAccountAge    Int      @default(0)
  kickTimeout      Int      @default(0)
  logChannelId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model AutoModConfig {
  id                String   @id @default(cuid())
  guildId           String   @unique
  enabled           Boolean  @default(true)
  antiSpam          Boolean  @default(true)
  antiLink          Boolean  @default(false)
  antiInvite        Boolean  @default(true)
  antiScam          Boolean  @default(true)
  antiMassMention   Boolean  @default(true)
  antiCaps          Boolean  @default(false)
  antiZalgo         Boolean  @default(true)
  antiBadWords      Boolean  @default(true)
  antiDuplicate     Boolean  @default(true)
  maxMentions       Int      @default(5)
  maxLines          Int      @default(20)
  capsThreshold     Int      @default(70)
  spamThreshold     Int      @default(5)
  spamInterval      Int      @default(5000)
  badWords          String   @default("[]")
  whitelistRoles    String   @default("[]")
  whitelistChannels String   @default("[]")
  action            String   @default("delete")
  timeoutDuration   String   @default("5m")
  logChannelId      String?
  alertChannelId    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model Giveaway {
  id             String          @id @default(cuid())
  guildId        String
  channelId      String
  messageId      String?
  hostId         String
  prize          String
  description    String?
  winnerCount    Int             @default(1)
  winners        String          @default("[]")
  requiredRoleId String?
  requiredLevel  Int?
  minAccountAge  Int?
  bonusRoleId    String?
  bonusEntries   Int             @default(1)
  status         String          @default("active")
  endsAt         DateTime
  endedAt        DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  guild          Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  entries        GiveawayEntry[]

  @@index([guildId, status])
}

model GiveawayEntry {
  id         String   @id @default(cuid())
  giveawayId String
  userId     String
  entries    Int      @default(1)
  createdAt  DateTime @default(now())
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@unique([giveawayId, userId])
}

model UserLevel {
  id           String    @id @default(cuid())
  guildId      String
  userId       String
  xp           Int       @default(0)
  level        Int       @default(0)
  totalXp      Int       @default(0)
  messages     Int       @default(0)
  voiceMinutes Int       @default(0)
  lastXpAt     DateTime?
  guild        Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id])

  @@unique([guildId, userId])
  @@index([guildId, level])
}

model CustomCommand {
  id           String   @id @default(cuid())
  guildId      String
  name         String
  response     String
  embedJson    String?
  roleRequired String?
  cooldown     Int      @default(0)
  enabled      Boolean  @default(true)
  uses         Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
}

model PolicePersonnel {
  id          String              @id @default(cuid())
  guildId     String
  discordId   String
  badgeNumber String
  firstName   String
  lastName    String
  callsign    String?
  rank        String              @default("Officer")
  division    String              @default("Patrol")
  status      String              @default("active")
  hireDate    DateTime            @default(now())
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  photoUrl    String?
  guild       Guild               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  rankHistory PoliceRankHistory[]

  @@unique([guildId, discordId])
  @@unique([guildId, badgeNumber])
  @@index([guildId, rank])
  @@index([guildId, division])
  @@index([guildId, status])
}

model PoliceRankHistory {
  id           String          @id @default(cuid())
  guildId      String
  personnelId  String
  previousRank String?
  newRank      String
  changedBy    String
  reason       String?
  createdAt    DateTime        @default(now())
  guild        Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  personnel    PolicePersonnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@index([guildId, personnelId])
}

model Notification {
  id        String   @id @default(cuid())
  guildId   String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([guildId, read])
}
